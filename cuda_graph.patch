+
+int TensorHolder::AllocatedBytes(){
+    std::lock_guard<std::mutex> lck(mtx_);
+    int bytes = 0;
+    for(auto & t: tensors_){
+        bytes += t.AllocatedBytes();
+    }
+    return bytes;
+}
